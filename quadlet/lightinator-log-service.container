# lightinator-log-service.container
#
# Podman Quadlet unit file.
# Quadlet is built into Podman ≥ 4.4 and generates a systemd service
# automatically — no hand-written .service file required.
#
# ── Per-user install (recommended) ──────────────────────────────────────────
#   mkdir -p ~/.config/containers/systemd
#   cp lightinator-log-service.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user start lightinator-log-service
#   systemctl --user enable lightinator-log-service   # start on login
#
# Enable automatic updates (once, per-user):
#   systemctl --user enable --now podman-auto-update.timer
#   # The timer runs daily; check with:
#   systemctl --user list-timers podman-auto-update
#
# ── System-wide install (requires root) ─────────────────────────────────────
#   sudo cp lightinator-log-service.container /etc/containers/systemd/
#   sudo systemctl daemon-reload
#   sudo systemctl start lightinator-log-service
#   sudo systemctl enable lightinator-log-service
#   sudo systemctl enable --now podman-auto-update.timer
#
# ── Auto-update via podman-auto-update ──────────────────────────────────────
#   The AutoUpdate=registry line below instructs podman-auto-update to pull
#   a fresh image and restart the unit when the registry digest changes.
#   Enable the timer once:
#     systemctl --user enable --now podman-auto-update.timer
#
# ── Status / logs ────────────────────────────────────────────────────────────
#   systemctl --user status lightinator-log-service
#   journalctl --user -u lightinator-log-service -f
#
# ── Data directory ───────────────────────────────────────────────────────────
#   Logs and configuration are stored in ~/lightinator-log-service/data.
#   Override with Volume= below if you prefer a different path.

[Unit]
Description=Lightinator Log Service
Documentation=https://github.com/pljakobs/lightinator-log-service
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/pljakobs/lightinator-log-service:prod
ContainerName=lightinator-log-service

# Host networking is required for mDNS advertisement and UDP syslog reception.
Network=host

# Persistent data: logs + loki.json config.
# %h expands to the user's home directory (quadlet variable).
Volume=%h/lightinator-log-service/data:/app/data:Z

# Core settings — override as needed.
Environment=LLS_HTTP_HOST=0.0.0.0
Environment=LLS_HTTP_PORT=4821
Environment=LLS_UDP_HOST=0.0.0.0
Environment=LLS_UDP_PORT=5514
Environment=LLS_DATA_DIR=/app/data/logs
Environment=LLS_MAX_BYTES_PER_IP=20971520
Environment=LLS_RETENTION_DAYS=7
Environment=LLS_SERVICE_NAME=LightinatorLogService
Environment=LLS_MDNS_HOST=lightinator-logservice.local

# Discovery — set to a known controller IP or hostname if mDNS is unreliable.
Environment=LLS_DISCOVERY_SEEDS=lightinator.local

# Uncomment to point Loki config at a custom path inside the volume:
# Environment=LLS_LOKI_CONFIG=/app/data/loki.json

# Pull and restart automatically when the :prod image digest changes in GHCR.
AutoUpdate=registry

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
