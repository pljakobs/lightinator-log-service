{
  "name": "lightinator-log-service",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first UDP log collector for Lightinator",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "test:ci": "node -e \"require('node:fs').mkdirSync('test-results', { recursive: true })\" && node --test --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=test-results/node.xml test/*.test.js",
    "test:e2e": "playwright test",
    "changelog": "node scripts/gen-changelog.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "better-sqlite3": "^12.8.0",
    "bonjour-service": "^1.3.0",
    "cors": "^2.8.5",
    "dompurify": "^3.4.16",
    "dotenv": "^18.0.5",
    "express": "^4.21.2",
    "ollama": "^0.6.4",
    "openai": "^7.27.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "fast-xml-parser": "^5.11.2",
    "yaml": "^2.9.1"
  }
}
