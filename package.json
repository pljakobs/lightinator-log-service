{
  "name": "lightinator-log-service",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first UDP log collector for Lightinator",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "forceExit": true,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/ui/**",
      "!src/index.js"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
