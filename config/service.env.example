# lightinator-log-service — runtime configuration
#
# Copy this file to your data directory as "service.env" and edit as needed:
#
#   System install:  /var/lib/lightinator-log-service/data/service.env
#   Per-user:        ~/lightinator-log-service/data/service.env
#
# After editing, restart the service:
#   systemctl restart lightinator-log-service        (system)
#   systemctl --user restart lightinator-log-service (per-user)
#
# Lines starting with # are comments and ignored.
# Uncomment a line to override its default value.
#
# ─────────────────────────────────────────────────────────────────────────────
# HTTP API
# ─────────────────────────────────────────────────────────────────────────────

# Address the HTTP server binds to.
# 0.0.0.0 = all interfaces (default). Change to a specific IP to restrict access.
#LLS_HTTP_HOST=0.0.0.0

# TCP port for the web UI and REST API.
#LLS_HTTP_PORT=4821

# Allowed CORS origins for browser access. * = allow all (default).
# Set to your webapp origin to restrict, e.g. http://192.168.29.1:8080
#LLS_CORS_ORIGIN=*

# ─────────────────────────────────────────────────────────────────────────────
# UDP SYSLOG RECEIVER
# ─────────────────────────────────────────────────────────────────────────────

# Address the UDP syslog listener binds to.
#LLS_UDP_HOST=0.0.0.0

# UDP port that controllers send syslog messages to.
# Must match network.rsyslog.port on the firmware side.
#LLS_UDP_PORT=5514

# ─────────────────────────────────────────────────────────────────────────────
# LOG STORAGE
# ─────────────────────────────────────────────────────────────────────────────

# Directory where per-controller log files are written (inside the container).
# Default is /app/data/logs which maps to <data-dir>/logs on the host.
#LLS_DATA_DIR=/app/data/logs

# Maximum raw log bytes stored per controller IP before old entries are rotated.
# Default: 20971520 (20 MB)
#LLS_MAX_BYTES_PER_IP=20971520

# How many days of logs to retain before automatic pruning.
#LLS_RETENTION_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# SERVICE IDENTITY / mDNS
# ─────────────────────────────────────────────────────────────────────────────

# Name reported in health responses and mDNS advertisements.
#LLS_SERVICE_NAME=LightinatorLogService

# mDNS hostname under which the service announces itself on the local network.
# Clients can reach the web UI at http://<LLS_MDNS_HOST>:<LLS_HTTP_PORT>
#LLS_MDNS_HOST=lightinator-logservice.local

# ─────────────────────────────────────────────────────────────────────────────
# CONTROLLER DISCOVERY
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated list of controller IPs or hostnames used to bootstrap
# discovery. Only one reachable seed is needed — all peers are found via
# GET /hosts?all=true. Use a static IP if mDNS resolution is unreliable.
# Example: LLS_DISCOVERY_SEEDS=192.168.29.87,192.168.29.101
LLS_DISCOVERY_SEEDS=lightinator.local

# HTTP port the controllers listen on (default 80).
#LLS_DISCOVERY_PORT=80

# How often (ms) to re-query the controller network for new/changed controllers.
# Default: 300000 (5 minutes). Set lower for faster detection of new devices.
#LLS_DISCOVERY_REFRESH_MS=300000

# Path (inside the container) where the discovered controller list is persisted
# so it survives container restarts. Defaults to /app/data/controllers.json.
#LLS_CONTROLLER_STATE=/app/data/controllers.json

# ─────────────────────────────────────────────────────────────────────────────
# SYSLOG REMOTE CONTROL
# ─────────────────────────────────────────────────────────────────────────────

# The IP address or hostname of THIS host as reachable by the controllers.
# When set, toggling "Logging ON/OFF" in the UI pushes network.rsyslog.{host,port}
# directly to the firmware via POST /config — so the controller actually starts
# or stops sending syslog to this service.
#
# Set this to the IP of the machine running this container that the IoT VLAN
# can reach. If your container host is multi-homed or behind port forwarding,
# auto-detection may pick the wrong interface — set this explicitly.
#
# If left unset the service auto-detects the best local IPv4 address.
# The UI logging toggle will still work but only filters logs server-side if
# auto-detection fails.
#
# Example: LLS_SYSLOG_ADVERTISE_HOST=192.168.29.10
#LLS_SYSLOG_ADVERTISE_HOST=

# ─────────────────────────────────────────────────────────────────────────────
# LOKI FORWARDING
# ─────────────────────────────────────────────────────────────────────────────

# Path (inside the container) of the Loki JSON config file.
# Edit via the web UI settings panel — no need to change this path.
#LLS_LOKI_CONFIG=/app/data/loki.json
